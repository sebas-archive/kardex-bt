<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup="false": la identidad del dispositivo y la Outbox no deben restaurarse en otra instalación (D18). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bluetooth clásico (RFCOMM). Android 12+ pide CONNECT/SCAN en ejecución; hasta Android 11 buscar dispositivos exige ubicación. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <!-- Escáner de códigos de barras; sin cámara se puede digitar el SKU. No hay permiso de INTERNET: la app no usa red. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="true" />

    <!-- Producto «Kardex»; el paquete/applicationId co.edu.umariana.inventario NO se renombra: es el identificador institucional y cambiarlo rompe instalaciones y datos. -->
    <!-- Pantallas en vertical fija: la app se usa con una mano mientras se cuenta. -->
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_app"
        android:label="Kardex"
        android:supportsRtl="true"
        android:theme="@style/Theme.Inventario">

        <activity android:name=".ui.HomeActivity" android:screenOrientation="portrait" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.AuthActivity" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.EstadoCuentaActivity" android:screenOrientation="portrait" />
        <activity android:name=".ui.PerfilActivity" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <!-- Fase 4: la cámara escribe la foto de evidencia en la caché de la app a través de este proveedor. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fotos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/rutas_fotos" />
        </provider>
        <activity android:name=".ui.CatalogoActivity" android:screenOrientation="portrait" />
        <activity android:name=".ui.NotificacionesActivity" android:screenOrientation="portrait" />
        <activity android:name=".ui.FotoEditorActivity" android:screenOrientation="portrait" />
        <activity android:name=".ui.ContarActivity" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.LecturasActivity" android:screenOrientation="portrait" />
        <activity android:name=".ui.PendientesActivity" android:screenOrientation="portrait" />
        <activity android:name=".ui.SincronizarActivity" android:screenOrientation="portrait" />
    </application>

</manifest>
