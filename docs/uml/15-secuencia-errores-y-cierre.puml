@startuml
!include estilo.iuml
title 15 · Secuencia: fila en ERROR, alta del producto, reprocesar y cerrar el conteo
autonumber
actor Administrador as adm
participant "MonitorView" as mon
participant "ConteoView" as cv
participant "QueryWorker\n(hilo de trabajo)" as w
