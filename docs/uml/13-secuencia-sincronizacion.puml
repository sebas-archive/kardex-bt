@startuml
!include estilo.iuml
title 13 · Secuencia: sincronización completa con el catálogo ACTUAL
autonumber
actor Administrador as adm
participant "Servicio Bluetooth\n(SyncController)" as ctrl
participant BluezTransport as bz
participant "bluetoothd" as bluez
participant "APK\n(SyncClient)" as apk
participant Session as ses
participant Store as st
database "Oracle\n(PKG_BATCH)" as ora
participant "Escritorio\n(ServicioRemoto)" as gui

note over ctrl : el servicio está siempre activo\n(se pausa o reanuda desde Sincronización)
ctrl -> bz : begin_pairing(on_passkey) · serve(on_connection)
bz -> bluez : Alias = gestion_inventario · Discoverable\nRegisterProfile(UUID 7a1c0b52-…)
opt el teléfono pide emparejamiento (BT_CON_CLAVE=1)
  bluez -> bz : RequestConfirmation(passkey)
  bz -> ctrl : on_passkey(codigo)
  note over ctrl : estado CONFIRMAR_CODIGO
  ctrl --> gui : código de 6 dígitos
  adm -> gui : «Aceptar código» / «Rechazar»
  gui -> ctrl : confirm(True/False)
end
apk -> bluez : conectar (socket RFCOMM; con código si BT_CON_CLAVE=1)
bluez -> bz : NewConnection(fd)
bz -> ctrl : on_connection(conn)
note over ctrl : estado CONECTADO
ctrl -> ses : Session(conn, store).run()
apk -> ses : HELLO|5|uuid|nombre
apk -> ses : ACCT|usuario|nombre
note over ctrl : estado RECIBIENDO
ses -> st : sincronizar_cuenta(usuario, nombre)
ses -> apk : ACCTST|usuario|estado|rol|motivo
note right of apk : sin ACTIVO: ningún REC\n(NAK CUENTA_NO_ACTIVA)
ses -> st : register_device · open_sync · last_seq(uuid)
ses -> apk : READY|ultimo_seq|epoch_ms
ses -> st : catalog(usuario si ACTIVO)
ses -> apk : CATTAREA|CATALOGO|Catálogo|||ABIERTO|total|contados
ses -> apk : CATITEM|CATALOGO|sku|N (por producto)
ses -> apk : CATPROD|sku|nombre|categoria|unidad (por producto)
ses -> apk : CAT_END
opt el móvil manda INICIO (opcional)
  apk -> ses : INICIO|id
  note over ses : se tolera y se ignora
end
loop hasta 50 REC sin ACK
  apk -> ses : REC|seq|ts|ACTUAL|sku|cantidad|operador|nota|danados
  ses -> st : insert_staging(uuid, seq, raw)
  opt cada 25 insertados
    ses -> st : commit()
    ses -> apk : ACK|n
  end
end
opt fotos por enviar (protocolo 5)
  loop una foto a la vez
    apk -> ses : FOTO|seq|parte|total|crc32|base64 (x N)
    ses -> st : commit() de lo pendiente · guardar_foto(uuid, seq, datos)
    ses -> apk : FOTOOK|seq  (o FOTOERR|seq|motivo)
  end
end
apk -> ses : END|n
ses -> st : commit()
ses -> apk : ACK|n
ses -> apk : BYE|aceptados|rechazados
ses --> ctrl : fin de sesión
note over ctrl : estado PROCESANDO (D9: el batch corre fuera de la sesión)
ctrl -> st : run_batch("SYNC")
st -> ora : PKG_BATCH.procesar_pendientes('SYNC') + conciliar ACTUAL
ora --> st : procesados, errores
note over ctrl : estado LISTO
ctrl --> gui : on_change(status) → señal listo
gui -> ora : refresco de las vistas V_* (hilos de trabajo)
@enduml
