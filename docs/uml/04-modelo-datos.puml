@startuml
!include estilo.iuml
title 04 · Modelo de datos Oracle (entidad-relación; sin ubicaciones)
hide circle
skinparam linetype ortho

class conteos <<table>> {
  * id_conteo : VARCHAR2(30) <<PK>>
  --
  nombre : VARCHAR2(100)
  estado : ABIERTO | CERRADO
  fecha_inicio : TIMESTAMP
  fecha_cierre : TIMESTAMP
  .. tarea (Fase 3) ..
  almacen : VARCHAR2(20)
  operador : VARCHAR2(30)
  instrucciones : VARCHAR2(500)
  iniciada : TIMESTAMP
  creada_por : VARCHAR2(30)
  creada : TIMESTAMP
}
class revisiones <<table>> {
  * id_conteo <<PK>>
  * sku <<PK>>
  --
  accion : REVISADA | RECUENTO
  nota : VARCHAR2(300)
  por : VARCHAR2(30)
  fecha : TIMESTAMP
}
class productos <<table>> {
  * sku : VARCHAR2(30) <<PK>>
  --
  nombre
  categoria
  unidad
  costo_unit : NUMBER(12,2)
  tolerancia_pct : NUMBER(5,2)
  stock_minimo : NUMBER(12,3)
}
class usuarios <<table>> {
  * usuario : VARCHAR2(30) <<PK>>
  --
  nombre
  rol : ADMIN | INVENTARIO | OPERADOR
  clave_hash : PBKDF2 ('-' si viene del móvil)
  estado : PENDIENTE | ACTIVO | RECHAZADO | SUSPENDIDO
  motivo · resuelto_por · resuelto
  origen : ESCRITORIO | MOVIL
  intentos · bloqueado_hasta
}
class categorias <<table>> {
  * nombre <<PK>>
  --
  activa : S | N
}
class almacenes <<table>> {
  * codigo <<PK>>
  --
  nombre · ubicacion
  activo : S | N
}
class existencias <<table>> {
  * sku <<PK, FK>>
  * codigo_almacen <<PK, FK>>
  --
  cantidad : NUMBER(12,3) ≥ 0
}
class permisos <<table>> {
  * rol <<PK>>
  * modulo <<PK>>
  --
  nivel : NINGUNO | CONSULTA | GESTION
}
class stock_sistema <<table>> {
  * id_conteo <<PK, FK>>
  * sku <<PK, FK>>
  --
  cantidad_sistema : NUMBER(12,3)
}
class dispositivos <<table>> {
  * uuid : VARCHAR2(50) <<PK>>
  --
  nombre
  ultima_sync : TIMESTAMP
}
class captura_transito <<table>> {
  * id_transito : NUMBER <<PK>>
  --
  uuid_dispositivo <<UK>>
  seq <<UK>>
  datos_raw : VARCHAR2(4000 BYTE)
  estado : PENDIENTE | PROCESANDO | PROCESADO | ERROR
  mensaje_error
  fecha_recepcion
  fecha_reclamo
}
class registros_procesados <<table>> {
  * id_registro : NUMBER <<PK>>
  --
  id_transito <<FK, SET NULL>>
  id_conteo <<FK>>
  sku <<FK>>
  cantidad : NUMBER(12,3)
  operador
  nota
  fecha_captura : TIMESTAMP (UTC)
  vigente : S | N
  fecha_procesado
}
class conciliacion <<table>> {
  * id_conteo <<PK, FK>>
  * sku <<PK, FK>>
  --
  cant_sistema
  cant_contada
  diferencia
  diferencia_pct
  valor_diferencia
  clasificacion : OK | FALTANTE | SOBRANTE | SIN_CONTAR
  fecha_calculo
}
class sync_sesiones <<table>> {
  * id : NUMBER <<PK>>
  --
  uuid_dispositivo
  inicio
  fin
  recibidos
  aceptados
}
class log_batch <<table>> {
  * id : NUMBER <<PK>>
  --
  inicio
  fin
  procesados
  errores
  origen
}

conteos "1" -- "0..*" stock_sistema
productos "1" -- "0..*" stock_sistema
conteos "1" -- "0..*" registros_procesados
productos "1" -- "0..*" registros_procesados
captura_transito "1" -- "0..1" registros_procesados : id_transito
conteos "1" -- "0..*" conciliacion
productos "1" -- "0..*" conciliacion
dispositivos "1" .. "0..*" captura_transito : uuid (sin FK)
dispositivos "1" .. "0..*" sync_sesiones : uuid (sin FK)
productos "1" -- "0..*" existencias
almacenes "1" -- "0..*" existencias
categorias "1" .. "0..*" productos : nombre = categoria
conteos "1" -- "0..*" revisiones
almacenes "1" .. "0..*" conteos : almacen (sin FK)
@enduml
