@startuml
!include estilo.iuml
title 14 · Secuencia: corte a mitad de lote, READY|25 y go-back-N
autonumber
participant "APK\n(SyncClient + Outbox)" as apk
participant Session as ses
participant Store as st

== Primera conexión: 30 lecturas, corte tras la 30 ==
apk -> ses : REC 1 … REC 25
ses -> st : insert_staging ×25 · commit()
ses -> apk : ACK|25
note left of apk : Outbox: 1–25 CONFIRMADO
apk -> ses : REC 26 … REC 30
ses -> st : insert_staging ×5 (sin COMMIT)
note left of apk : Outbox: 26–30 ENVIADO
destroy ses
note over st : readline() = None → rollback()\nquedan 25 filas, las confirmadas

== Reconexión (el cliente reintenta solo) ==
apk -> ses : HELLO|4|uuid|nombre
apk -> ses : ACCT|usuario|nombre
ses -> st : sincronizar_cuenta() = ACTIVO
ses -> apk : ACCTST|usuario|ACTIVO|OPERADOR|
ses -> st : last_seq(uuid) = 25
ses -> apk : READY|25|epoch_ms
note left of apk : reconciliar(25): ≤ 25 CONFIRMADO;\n26–30 ENVIADO → PENDIENTE
ses -> apk : catálogo … CAT_END

== Go-back-N con una línea dañada ==
apk -> ses : REC 26
apk -> ses : REC 27
apk -> ses : REC 28 (llega con CRC malo)
ses -> apk : NAK|28|CRC
apk -> ses : REC 29
note over ses : se ignora en silencio\n(no hay un segundo NAK)
note left of apk : retrocede a 28
apk -> ses : REC 28 · REC 29 · REC 30
note over ses : 26 y 27 se insertaron; 28 a 30 llegan una sola vez.\nUn seq ya persistido (seq < esperado) se descarta:\nla clave (uuid, seq) impide duplicados
apk -> ses : END|5
ses -> st : commit()
ses -> apk : ACK|30
ses -> apk : BYE|5|1
note left of apk : 26–30 CONFIRMADO\nCAPTURA_TRANSITO = 30 filas, sin duplicados
@enduml
