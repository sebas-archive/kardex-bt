@startuml
!include estilo.iuml
' @code: desktop/app, server/btsync
title 02 · Clases de la aplicación de escritorio
left to right direction

class MainWindow {
  +refresh_requested : pyqtSignal
  +cerrando : pyqtSignal
  +add_view(view, title, index)
  +select_conteo(id_conteo)
  +conteo_actual() : str
}
class SyncBridge <<QObject>> {
  +status_changed : pyqtSignal
  +listo : pyqtSignal
  +start()
  +confirm(accept)
  +cancel()
  +status() : dict
}
class QueryRunner {
  +run(fn, on_ok, on_error, key)
}
class QueryWorker <<QRunnable>> {
  +run()
}
class WorkerSignals <<QObject>>
class StateBanner {
  +show_loading()
  +show_empty(texto)
  +show_error(texto)
  +clear()
}
class SyncView
class ConteoView
class ConciliacionView
class ChartsView
class PerfilView
class MonitorView
class ConciliacionModel <<QAbstractTableModel>>
class DetalleLecturas
class EjeFormato <<AxisItem>>

interface RefreshableView <<Protocol>> {
  +set_conteo(id_conteo)
  +refresh()
}

package "app.db (módulo, una conexión Oracle por hilo)" as dbmod {
  entity "db" as db {
    fetch_conteos()
    fetch_resumen(id_conteo)
    fetch_conciliacion(...)
    fetch_dif_por_categoria(id_conteo)
    fetch_top_desvios(id_conteo)
    fetch_distribucion(id_conteo)
    fetch_avance_zona(id_conteo)
    fetch_actividad(id_conteo)
    fetch_lecturas(id_conteo, sku)
    fetch_estado_batch()
    fetch_errores()
    cerrar_conteo(id_conteo)
    reprocesar_errores(id_conteo)
    procesar_ahora()
    fetch_perfil(id_conteo)
  }
}

class SyncController <<btsync>>

RefreshableView <|.. SyncView
RefreshableView <|.. ConteoView
RefreshableView <|.. ConciliacionView
RefreshableView <|.. ChartsView
RefreshableView <|.. PerfilView
RefreshableView <|.. MonitorView
MainWindow o-- RefreshableView : pestañas (add_view)
MainWindow --> QueryRunner : lista de conteos
MainWindow *-- StateBanner
RefreshableView ..> QueryRunner : consultas fuera del hilo de la UI
RefreshableView *-- StateBanner
QueryRunner ..> QueryWorker : lanza
QueryWorker *-- WorkerSignals
QueryWorker ..> db : fetch_*
SyncView --> SyncBridge
MonitorView --> SyncBridge
SyncBridge *-- SyncController
ConciliacionView *-- ConciliacionModel
ConciliacionView *-- DetalleLecturas
ChartsView *-- EjeFormato
@enduml
