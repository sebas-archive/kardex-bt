@startuml
!include estilo.iuml
title 15 · Secuencia: SKU nuevo, decisión del Administrador y reproceso de errores
autonumber
actor Administrador as adm
participant "MainWindow\n(AvisoNuevoSku)" as av
participant "QueryWorker\n(hilo de trabajo)" as w
database "Oracle (PKG_BATCH)" as ora

note over ora : llegó una lectura con SKU «X9»\nque no está en PRODUCTOS
ora -> ora : procesar_pendientes: fila → NUEVO_SKU\n(no es un error)
av -> w : fetch_nuevos_sku()  (sondeo cada 2,8 s)
w -> ora : SELECT … FROM v_nuevos_sku
ora --> av : SKU y cuántas lecturas esperan
av -> adm : aviso flotante «Nuevo SKU»
alt «Crear y procesar»
  adm -> av : nombre y categoría (SKU precargado)
  av -> w : nuevo_sku_alta(quien, sku, nombre, categoria)
  w -> ora : PKG_BATCH.alta_y_procesar(...)
  ora -> ora : INSERT productos + stock 0 en ACTUAL\nNUEVO_SKU → PENDIENTE · procesar_pendientes
  ora -> ora : conciliar ACTUAL
  ora --> av : fila PROCESADO
else «No crear»
  adm -> av : confirma
  av -> w : descartar_nuevo_sku(quien, sku)
  w -> ora : PKG_BATCH.descartar_nuevo_sku(sku)
  ora -> ora : NUEVO_SKU → DESCARTADO\n(no se cuenta)
end
av -> av : datos_cambiados → refresco de todas las vistas
note over adm, ora
  Aparte: las filas en ERROR (formato, cantidad o dañados inválidos)
  se corrigen y se reenvían con «Reprocesar errores»:
  reprocesar_errores() → PKG_BATCH.reprocesar_errores() → ERROR → PENDIENTE.
end note
@enduml
