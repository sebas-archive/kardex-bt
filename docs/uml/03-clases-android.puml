@startuml
!include estilo.iuml
' @code: mobile/app/src/main
title 03 · Clases de la APK Android (MVVM)
left to right direction

package "auth (contraseña local, estado del PC)" {
  class AuthRepository {
    +registrar(usuario, nombre, clave, confirmacion, pregunta, respuesta) : AuthResult
    +aplicarEstado(usuario, estado, rol, motivo)
    +iniciarSesion(usuario, clave) : AuthResult
    +preguntaDe(usuario) : String?
    +restablecer(usuario, respuesta, clave, confirmacion) : AuthResult
    +cambiarClave(actual, nueva, confirmacion) : AuthResult
    +sesion() : Sesion?
    +cerrarSesion()
  }
  class AuthResult <<sealed>> {
    Ok(usuario) · CredencialesInvalidas · Bloqueado(segundos)
    ClaveDebil · UsuarioExiste · RespuestaIncorrecta · …
  }
  class Sesion {
    +usuario
    +nombre
    +rol
    +estado
    +motivo
    +puedeTrabajar : Boolean
  }
  class Rol <<object>> {
    OPERADOR
  }
  class EstadoCuenta <<object>> {
    PENDIENTE · ACTIVO · RECHAZADO · SUSPENDIDO
  }
  class Claves <<object>> {
    +crear(secreto) : String
    +verificar(secreto, guardado) : Boolean
    +fuerza(clave) : Int
  }
  class UsuarioEntity {
    +usuario
    +nombre
    +rol
    +estado
    +motivo
    +claveHash
    +pregunta
    +respuestaHash
    +intentosFallidos
    +bloqueadoHastaMs
  }
  class CuentasDatabase
}

package "scan" {
  class CodigoEscaneado <<object>> {
    +sku(contenido) : String
  }
}

package "ui (vista y modelo de vista)" {
  class AuthActivity
  class PerfilActivity
  class HomeActivity
  class ContarActivity
  class SincronizarActivity
  class PantallaActivity
  class CountViewModel {
    +operador : StateFlow<String>
    +conteo : StateFlow<String?>
    +guardar(sku, cantidad, nota) : SaveResult
    +ultimaLectura(sku) : LecturaEntity?
    +setOperador(nombre)
    +lecturas() : List<LecturaEntity>
  }
  class SaveResult <<sealed>> {
    Guardada(seq, reemplazo, skuDesconocido)
    OperadorFaltante · SinConteo
    SkuFaltante · CantidadInvalida · NotaLarga
  }
  class SyncViewModel {
    +estado : StateFlow<SyncEstado?>
    +iniciar(direccion)
    +cancelar()
  }
  class SyncRunner {
    +ejecutar() : Flow<SyncEstado>
  }
  class SyncEstado <<sealed>> {
    Conectando · Sincronizando · Reintentando · Listo
    Ocupado · Rechazado · PcNoDisponible · Cortado
  }
  class SettingsStore {
    +operador
    +conteo
    +pcDireccion
  }
  class Servicios
}

package "sync" {
  class SyncClient {
    +sync(socket : BluetoothSocketLike) : Flow<SyncProgress>
  }
  class SyncProgress <<sealed>> {
    Connected(ultimoSeqServidor, porEnviar)
    Progress(confirmadoHasta, total)
    Done(aceptados, rechazados, pendientes)
    Busy · Rejected(motivo) · Cut(motivo, pendientes)
    CuentaNoActiva(estado, motivo, pendientes)
  }
  interface BluetoothSocketLike {
    +inputStream
    +outputStream
  }
  class AndroidBluetoothSocket
  class PcConnector {
    +conectar(direccion) : BluetoothSocketLike
  }
  class LineReader {
    +readLine() : ByteArray?
  }
}

package "protocol" {
  class Protocol <<object>> {
    +frame(fields) : ByteArray
    +parse(line) : Message
    +encodeText(s) : String
    +decodeText(s) : String
  }
  class Message {
    +kind : String
    +fields : List<String>
  }
  class Rec {
    +toRaw() : String
    +toFrame() : ByteArray
  }
  class FrameError {
    +reason : String
  }
}

package "data (Room)" {
  class AppDatabase
  class Outbox {
    +insertar(l) : Long
    +pendientesDesde(seq)
    +confirmarHasta(seq)
    +reemplazar(idConteo, sku, cantidad, ts) : Boolean
    +tomarParaEnviar(seq)
    +reconciliar(ultimoSeqServidor)
  }
  class LecturaEntity {
    +seq : Long
    +tsOriginalMs : Long
    +idConteo
    +sku
    +cantidad
    +operador
    +nota
    +estado
  }
  class Estado <<object>> {
    PENDIENTE · ENVIADO · CONFIRMADO
  }
  class CatalogRepository {
    +reemplazarTodo(c : Catalog)
    +tareas() / items(idTarea)
    +marcarIniciada(idTarea)
    +producto(sku)
  }
  class CatalogDao
  class Catalog
  class TareaEntity
  class ItemTareaEntity
  class InicioEntity
  class FotoEntity
  class FotoRepository {
    +adjuntar(seq, temporal)
    +enviables()
  }
  class ProductoEntity
}

class DeviceIdentity <<object>> {
  +get(context) : String
}

AuthActivity --|> PantallaActivity
PerfilActivity --|> PantallaActivity
AuthActivity --> AuthRepository
PerfilActivity --> AuthRepository
HomeActivity ..> AuthRepository : exige sesión
Servicios *-- AuthRepository
AuthRepository --> SettingsStore : sesión abierta
AuthRepository --> CuentasDatabase
AuthRepository ..> Claves
AuthRepository ..> AuthResult
AuthRepository ..> Sesion
CuentasDatabase "1" o-- "*" UsuarioEntity
UsuarioEntity ..> Rol
ContarActivity ..> CodigoEscaneado : barras o QR → SKU
HomeActivity --|> PantallaActivity
ContarActivity --|> PantallaActivity
SincronizarActivity --|> PantallaActivity
ContarActivity --> CountViewModel
SincronizarActivity --> SyncViewModel
Servicios *-- CountViewModel
Servicios *-- SettingsStore
Servicios *-- PcConnector
CountViewModel --> Outbox
CountViewModel --> CatalogRepository
CountViewModel --> SettingsStore
CountViewModel ..> SaveResult
SyncViewModel *-- SyncRunner
SyncViewModel ..> DeviceIdentity
SyncRunner --> SyncClient
SyncRunner ..> SyncEstado
SyncClient --> Outbox
SyncClient --> CatalogRepository
SyncClient --> LineReader
SyncClient --> Protocol
SyncClient ..> SyncProgress
SyncClient ..> BluetoothSocketLike
BluetoothSocketLike <|.. AndroidBluetoothSocket
PcConnector ..> AndroidBluetoothSocket : crea
Protocol ..> Message
Protocol ..> FrameError
Rec ..> Protocol
Outbox "1" o-- "*" LecturaEntity
LecturaEntity ..> Estado
AppDatabase *-- Outbox
AppDatabase *-- CatalogDao
CatalogRepository --> CatalogDao
CatalogDao ..> Catalog
Catalog o-- TareaEntity
Catalog o-- ItemTareaEntity
CatalogDao ..> InicioEntity
Catalog o-- ProductoEntity
@enduml
