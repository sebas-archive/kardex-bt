' Estilo común de todos los diagramas (se incluye con !include estilo.iuml).
skinparam shadowing false
skinparam roundCorner 6
skinparam defaultFontName SansSerif
skinparam defaultFontSize 12
skinparam ArrowColor #475467
skinparam BackgroundColor #FFFFFF
skinparam TitleFontSize 15
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #475467
  HeaderBackgroundColor #E0EAFF
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #98A2B3
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #F79009
}
' --- Ajustes para el documento impreso: diagramas más compactos y texto legible al escalar ---
skinparam maxMessageSize 170
skinparam wrapWidth 200
skinparam nodesep 14
skinparam ranksep 22
skinparam ParticipantPadding 8
skinparam BoxPadding 4
skinparam dpi 130
skinparam sequence {
  LifeLineBorderColor #98A2B3
  ParticipantBackgroundColor #E0EAFF
}
